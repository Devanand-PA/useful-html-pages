e/categories/25/drama"}},"manga":{"links":{"self":"https://kitsu.io/api/edge/categories/25/relationships/manga","related":"https://kitsu.io/api/edge/categories/25/manga"}}}},{"id":"156","type":"categories","links":{"self":"https://kitsu.io/api/edge/categories/156"},"attributes":{"createdAt":"2017-05-31T06:39:22.629Z","updatedAt":"2021-10-02T01:30:58.996Z","title":"Fantasy","description":"Fantasy is a genre of fiction that uses magic and other supernatural phenomena as a primary element of plot, theme, or setting. Many works within the genre take place in fictional worlds where magic is common. Fantasy is generally distinguished from science fiction and horror by the expectation that it steers clear of (pseudo-)scientific and macabre themes, respectively, though there is a great deal of overlap between the three (which are subgenres of speculative fiction).\n\nIn popular culture, the genre of fantasy is dominated by its medievalist form, especially since the worldwide success of The Lord of the Rings books by J. R. R. Tolkien. In its broadest sense however, fantasy comprises works by many writers, artists, filmmakers, and musicians, from ancient myths and legends to many recent works embraced by a wide audience today.\n\nFantasy is a vibrant area of academic study in a number of disciplines (English, cultural studies, comparative literature, history, medieval studies). Work in this area ranges widely, from the structuralist theory of Tzvetan Todorov, which emphasizes the fantastic as a liminal space, to work on the connections (political, historical, literary) between medievalism and popular culture\n\nSource: Wiki","totalMediaCount":26598,"slug":"fantasy","nsfw":false,"childCount":10},"relationships":{"parent":{"links":{"self":"https://kitsu.io/api/edge/categories/156/relationships/parent","related":"https://kitsu.io/api/edge/categories/156/parent"}},"anime":{"links":{"self":"https://kitsu.io/api/edge/categories/156/relationships/anime","related":"https://kitsu.io/api/edge/categories/156/anime"}},"drama":{"links":{"self":"https://kitsu.io/api/edge/categories/156/relationships/drama","related":"https://kitsu.io/api/edge/categories/156/drama"}},"manga":{"links":{"self":"https://kitsu.io/api/edge/categories/156/relationships/manga","related":"https://kitsu.io/api/edge/categories/156/manga"}}}},{"id":"159","type":"categories","links":{"self":"https://kitsu.io/api/edge/categories/159"},"attributes":{"createdAt":"2017-05-31T06:39:23.905Z","updatedAt":"2021-10-02T01:30:59.149Z","title":"Thriller","description":"The thriller is a genre of fiction in which tough, resourceful, but essentially ordinary heroes are pitted against villains determined to destroy them, their country, or the stability of the free world. The hero of a typical thriller faces danger alone or in the company of a small band of companions. The protagonist may be a law enforcement agent, a journalist, or a soldier, but typically he or she is cut off from the resources of \"their\" organization. More often the hero is an ordinary citizen drawn into danger and intrigue by circumstances beyond their control. (Source: Wikipedia)","totalMediaCount":2784,"slug":"thriller","nsfw":false,"childCount":0},"relationships":{"parent":{"links":{"self":"https://kitsu.io/api/edge/categories/159/relationships/parent","related":"https://kitsu.io/api/edge/categories/159/parent"}},"anime":{"links":{"self":"https://kitsu.io/api/edge/categories/159/relationships/anime","related":"https://kitsu.io/api/edge/categories/159/anime"}},"drama":{"links":{"self":"https://kitsu.io/api/edge/categories/159/relationships/drama","related":"https://kitsu.io/api/edge/categories/159/drama"}},"manga":{"links":{"self":"https://kitsu.io/api/edge/categories/159/relationships/manga","related":"https://kitsu.io/api/edge/categories/159/manga"}}}},{"id":"232","type":"categories","links":{"self":"https://kitsu.io/api/edge/categories/232"},"attributes":{"createdAt":"2017-06-07T19:38:10.577Z","updatedAt":"2021-10-02T01:30:59.608Z","title":"Psychological","description":"Psychological media delve into mental or emotional states of a character in the midst of a difficult situation, letting you observe them change as tension increases. Internal monologues are a key feature, allowing narration to delve into a character's mind, revealing their innermost ideas and motivations - even as they may be driven to the brink of sanity.","totalMediaCount":3514,"slug":"psychological","nsfw":false,"childCount":2},"relationships":{"parent":{"links":{"self":"https://kitsu.io/api/edge/categories/232/relationships/parent","related":"https://kitsu.io/api/edge/categories/232/parent"}},"anime":{"links":{"self":"https://kitsu.io/api/edge/categories/232/relationships/anime","related":"https://kitsu.io/api/edge/categories/232/anime"}},"drama":{"links":{"self":"https://kitsu.io/api/edge/categories/232/relationships/drama","related":"https://kitsu.io/api/edge/categories/232/drama"}},"manga":{"links":{"self":"https://kitsu.io/api/edge/categories/232/relationships/manga","related":"https://kitsu.io/api/edge/categories/232/manga"}}}},{"id":"246","type":"categories","links":{"self":"https://kitsu.io/api/edge/categories/246"},"attributes":{"createdAt":"2018-12-28T19:19:12.049Z","updatedAt":"2021-10-02T01:31:01.031Z","title":"Isekai","description":"An isekai story is one in which the lead characters are transferred to and become stuck or trapped in another world, one completely different from the one they lived in up until the transfer. The new world is commonly a fictional world.  In order to adapt to their new environment, they must use the abilities and knowledge brought from their former world as well as any that may have been bestowed upon them by their brave new world. In some cases, they will seek and eventually find a way to return; in others, they will gleefully embrace their new life.","totalMediaCount":2812,"slug":"isekai","nsfw":false,"childCount":0},"relationships":{"parent":{"links":{"self":"https://kitsu.io/api/edge/categories/246/relationships/parent","related":"https://kitsu.io/api/edge/categories/246/parent"}},"anime":{"links":{"self":"https://kitsu.io/api/edge/categories/246/relationships/anime","related":"https://kitsu.io/api/edge/categories/246/anime"}},"drama":{"links":{"self":"https://kitsu.io/api/edge/categories/246/relationships/drama","related":"https://kitsu.io/api/edge/categories/246/drama"}},"manga":{"links":{"self":"https://kitsu.io/api/edge/categories/246/relationships/manga","related":"https://kitsu.io/api/edge/categories/246/manga"}}}}],"meta":{"count":14},"links":{"first":"https://kitsu.io/api/edge/anime?filter%5Btext%5D=Re%3AZero+kara+hajimeru+isekai+seikatsu&include=genres%2Ccategories&page%5Blimit%5D=3&page%5Boffset%5D=0","next":"https://kitsu.io/api/edge/anime?filter%5Btext%5D=Re%3AZero+kara+hajimeru+isekai+seikatsu&include=genres%2Ccategories&page%5Blimit%5D=3&page%5Boffset%5D=3","last":"https://kitsu.io/api/edge/anime?filter%5Btext%5D=Re%3AZero+kara+hajimeru+isekai+seikatsu&include=genres%2Ccategories&page%5Blimit%5D=3&page%5Boffset%5D=11"}}