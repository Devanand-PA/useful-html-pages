tegories/128/anime"}},"drama":{"links":{"self":"https://kitsu.io/api/edge/categories/128/relationships/drama","related":"https://kitsu.io/api/edge/categories/128/drama"}},"manga":{"links":{"self":"https://kitsu.io/api/edge/categories/128/relationships/manga","related":"https://kitsu.io/api/edge/categories/128/manga"}}}},{"id":"144","type":"categories","links":{"self":"https://kitsu.io/api/edge/categories/144"},"attributes":{"createdAt":"2017-05-31T06:39:18.931Z","updatedAt":"2021-10-02T01:31:00.854Z","title":"Asia","description":"Asia is Earth's largest and most populous continent, located primarily in the eastern and northern hemispheres and sharing the continental landmass of Eurasia with the continent of Europe. Asia covers an area of 44,579,000 square kilometers, about 30% of Earth's total land area and 8.7% of the Earth's total surface area. The continent, which has long been home to the majority of the human population, was the site of many of the first civilizations. Asia is notable for not only its overall large size and population, but also dense and large settlements as well as vast barely populated regions within the continent of 4.4 billion people.\n\nSource: Wikipedia","totalMediaCount":2255,"slug":"asia","nsfw":false,"childCount":3},"relationships":{"parent":{"links":{"self":"https://kitsu.io/api/edge/categories/144/relationships/parent","related":"https://kitsu.io/api/edge/categories/144/parent"}},"anime":{"links":{"self":"https://kitsu.io/api/edge/categories/144/relationships/anime","related":"https://kitsu.io/api/edge/categories/144/anime"}},"drama":{"links":{"self":"https://kitsu.io/api/edge/categories/144/relationships/drama","related":"https://kitsu.io/api/edge/categories/144/drama"}},"manga":{"links":{"self":"https://kitsu.io/api/edge/categories/144/relationships/manga","related":"https://kitsu.io/api/edge/categories/144/manga"}}}},{"id":"81","type":"categories","links":{"self":"https://kitsu.io/api/edge/categories/81"},"attributes":{"createdAt":"2017-05-31T06:38:50.904Z","updatedAt":"2021-10-02T01:31:00.874Z","title":"Japan","description":"Last stronghold for humanity. If Tokyo falls, it's all over. Tokyo Tower will undoubtedly fall anyway.","totalMediaCount":3151,"slug":"japan","nsfw":false,"childCount":2},"relationships":{"parent":{"links":{"self":"https://kitsu.io/api/edge/categories/81/relationships/parent","related":"https://kitsu.io/api/edge/categories/81/parent"}},"anime":{"links":{"self":"https://kitsu.io/api/edge/categories/81/relationships/anime","related":"https://kitsu.io/api/edge/categories/81/anime"}},"drama":{"links":{"self":"https://kitsu.io/api/edge/categories/81/relationships/drama","related":"https://kitsu.io/api/edge/categories/81/drama"}},"manga":{"links":{"self":"https://kitsu.io/api/edge/categories/81/relationships/manga","related":"https://kitsu.io/api/edge/categories/81/manga"}}}},{"id":"54","type":"categories","links":{"self":"https://kitsu.io/api/edge/categories/54"},"attributes":{"createdAt":"2017-05-31T06:38:48.575Z","updatedAt":"2021-10-02T01:31:00.586Z","title":"Earth","description":"The Earth is the third planet from the Sun, and the densest and fifth-largest of the eight planets in the Solar System. It is in effect a ball of hot mud, but on the surface it's cold enough, so most of us live on it (or are supposed to). It is circa 4.5 billion years old, and, unless we humans succeed in destroying it over the next couple of centuries, it is expected to last for quite another while, though the changes in the Sun's emissions due to its aging will likely cause the extinction of everything; the species of earthlings are guaranteed to die, even if we fail to kill them -- unless, of course, we find ourselves another planet and figure out a way to take everything there. Our little planet on a corner of this galaxy may mean nothing in the grand scheme of things, but to its inhabitants it is their home, so, as a species, we cherish it dearly, to the point many cultures even to this day deify it. Being the home to the human civilizations, the Earth is the main setting of most fiction, be it anime or otherwise, but not only are many titles set in other places, such as unrelated fantasy worlds, in a considerable number of fictional titles the Earth is actually destroyed by aggressive alien invaders.","totalMediaCount":2754,"slug":"earth","nsfw":false,"childCount":5},"relationships":{"parent":{"links":{"self":"https://kitsu.io/api/edge/categories/54/relationships/parent","related":"https://kitsu.io/api/edge/categories/54/parent"}},"anime":{"links":{"self":"https://kitsu.io/api/edge/categories/54/relationships/anime","related":"https://kitsu.io/api/edge/categories/54/anime"}},"drama":{"links":{"self":"https://kitsu.io/api/edge/categories/54/relationships/drama","related":"https://kitsu.io/api/edge/categories/54/drama"}},"manga":{"links":{"self":"https://kitsu.io/api/edge/categories/54/relationships/manga","related":"https://kitsu.io/api/edge/categories/54/manga"}}}},{"id":"9","type":"categories","links":{"self":"https://kitsu.io/api/edge/categories/9"},"attributes":{"createdAt":"2017-05-31T06:38:30.881Z","updatedAt":"2021-10-02T01:30:58.528Z","title":"Samurai","description":"","totalMediaCount":497,"slug":"samurai","nsfw":false,"childCount":0},"relationships":{"parent":{"links":{"self":"https://kitsu.io/api/edge/categories/9/relationships/parent","related":"https://kitsu.io/api/edge/categories/9/parent"}},"anime":{"links":{"self":"https://kitsu.io/api/edge/categories/9/relationships/anime","related":"https://kitsu.io/api/edge/categories/9/anime"}},"drama":{"links":{"self":"https://kitsu.io/api/edge/categories/9/relationships/drama","related":"https://kitsu.io/api/edge/categories/9/drama"}},"manga":{"links":{"self":"https://kitsu.io/api/edge/categories/9/relationships/manga","related":"https://kitsu.io/api/edge/categories/9/manga"}}}}],"meta":{"count":10},"links":{"first":"https://kitsu.io/api/edge/anime?filter%5Btext%5D=Dororo&include=genres%2Ccategor