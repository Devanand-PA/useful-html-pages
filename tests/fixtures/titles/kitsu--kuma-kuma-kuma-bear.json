pi/edge/anime/3702/relationships/quotes","related":"https://kitsu.io/api/edge/anime/3702/quotes"}},"episodes":{"links":{"self":"https://kitsu.io/api/edge/anime/3702/relationships/episodes","related":"https://kitsu.io/api/edge/anime/3702/episodes"}},"streamingLinks":{"links":{"self":"https://kitsu.io/api/edge/anime/3702/relationships/streaming-links","related":"https://kitsu.io/api/edge/anime/3702/streaming-links"}},"animeProductions":{"links":{"self":"https://kitsu.io/api/edge/anime/3702/relationships/anime-productions","related":"https://kitsu.io/api/edge/anime/3702/anime-productions"}},"animeCharacters":{"links":{"self":"https://kitsu.io/api/edge/anime/3702/relationships/anime-characters","related":"https://kitsu.io/api/edge/anime/3702/anime-characters"}},"animeStaff":{"links":{"self":"https://kitsu.io/api/edge/anime/3702/relationships/anime-staff","related":"https://kitsu.io/api/edge/anime/3702/anime-staff"}}}}],"included":[{"id":"157","type":"categories","links":{"self":"https://kitsu.io/api/edge/categories/157"},"attributes":{"createdAt":"2017-05-31T06:39:23.663Z","updatedAt":"2021-10-02T01:30:59.126Z","title":"Adventure","description":"Adventures are exciting stories, with new experiences or exotic locales. Adventures are designed to provide an action-filled, energetic experience for the viewer. Rather than the predominant emphasis on violence and fighting that is found in pure action anime, however, the viewer of adventures can live vicariously through the travels, conquests, explorations, creation of empires, struggles and situations that confront the main characters, actual historical figures or protagonists. Under the category of adventures, we can include traditional swashbucklers, serialized films, and historical spectacles, searches or expeditions for lost continents, \"jungle\" and \"desert\" epics, treasure hunts and quests, disaster films, and heroic journeys or searches for the unknown. Adventure films are often, but not always, set in an historical period, and may include adapted stories of historical or literary adventure heroes, kings, battles, rebellion, or piracy.","totalMediaCount":10897,"slug":"adventure","nsfw":false,"childCount":0},"relationships":{"parent":{"links":{"self":"https://kitsu.io/api/edge/categories/157/relationships/parent","related":"https://kitsu.io/api/edge/categories/157/parent"}},"anime":{"links":{"self":"https://kitsu.io/api/edge/categories/157/relationships/anime","related":"https://kitsu.io/api/edge/categories/157/anime"}},"drama":{"links":{"self":"https://kitsu.io/api/edge/categories/157/relationships/drama","related":"https://kitsu.io/api/edge/categories/157/drama"}},"manga":{"links":{"self":"https://kitsu.io/api/edge/categories/157/relationships/manga","related":"https://kitsu.io/api/edge/categories/157/manga"}}}},{"id":"160","type":"categories","links":{"self":"https://kitsu.io/api/edge/categories/160"},"attributes":{"createdAt":"2017-05-31T06:39:23.938Z","updatedAt":"2021-10-02T01:30:59.176Z","title":"Comedy","description":"Anime whose central struggle causes hilarious results. These stories are built upon funny characters, situations and events. A comedy anime is laced with humour and sets out to provoke laughter from the audience.\n\nJapanese humour can be a bit strange to westerners, so if you're new to this type of humour, just bear with it; it'll most likely grow on you if you're a fan of other kinds of comedy.","totalMediaCount":25974,"slug":"comedy","nsfw":false,"childCount":6},"relationships":{"parent":{"links":{"self":"https://kitsu.io/api/edge/categories/160/relationships/parent","related":"https://kitsu.io/api/edge/categories/160/parent"}},"anime":{"links":{"self":"https://kitsu.io/api/edge/categories/160/relationships/anime","related":"https://kitsu.io/api/edge/categories/160/anime"}},"drama":{"links":{"self":"https://kitsu.io/api/edge/categories/160/relationships/drama","related":"https://kitsu.io/api/edge/categories/160/drama"}},"manga":{"links":{"self":"https://kitsu.io/api/edge/categories/160/relationships/manga","related":"https://kitsu.io/api/edge/categories/160/manga"}}}},{"id":"156","type":"categories","links":{"self":"https://kitsu.io/api/edge/categories/156"},"attributes":{"createdAt":"2017-05-31T06:39:22.629Z","updatedAt":"2021-10-02T01:30:58.996Z","title":"Fantasy","description":"Fantasy is a genre of fiction that uses magic and other supernatural phenomena as a primary element of plot, theme, or setting. Many works within the genre take place in fictional worlds where magic is common. Fantasy is generally distinguished from science fiction and horror by the expectation that it steers clear of (pseudo-)scientific and macabre themes, respectively, though there is a great deal of overlap between the three (which are subgenres of speculative fiction).\n\nIn popular culture, the genre of fantasy is dominated by its medievalist form, especially since the worldwide success of The Lord of the Rings books by J. R. R. Tolkien. In its broadest sense however, fantasy comprises works by many writers, artists, filmmakers, and musicians, from ancient myths and legends to many recent works embraced by a wide audience today.\n\nFantasy is a vibrant area of academic study in a number of disciplines (English, cultural studies, comparative literature, history, medieval studies). Work in this area ranges widely, from the structuralist theory of Tzvetan Todorov, which emphasizes the fantastic as a liminal space, to work on the connections (political, historical, literary) between medievalism and popular culture\n\nSource: Wiki","totalMediaCount":26598,"slug":"fantasy","nsfw":false,"childCount":10},"relationships":{"parent":{"links":{"self":"https://kitsu.io/api/edge/categories/156/relationships/parent","related":"https://kitsu.io/api/edge/categories/156/parent"}},"anime":{"links":{"self":"https://kitsu.io/api/edge/categories/156/relationships/anime","related":"https://kitsu.io/api/edge/categories/156/anime"}},"drama":{"links":{"self":"https://kitsu.io/api/edge/categories/156/relationships/drama","related":"https://kitsu.io/api/edge/categories/156/drama"}},"manga":{"links":{"self":"https://kitsu.io/api/edge/categories/156/relationships/manga","related":"https://kitsu.io/api/edge/categories/156/manga"}}}},{"id":"52","type":"categories","links":{"self":"https://kitsu.io/api/edge/categories/52"},"attributes":{"createdAt":"2017-05-31T06:38:47.099Z","updatedAt":"2021-10-02T01:31:00.535Z","title":"Fantasy World","description":"A fantasy world is a type of imaginary world, part of a fictional universe. Typical worlds involve, but are not limited to magic or magical abilities and a medieval theme. Some examples include: a parallel world tenuously connected to Earth via magical portals or items; a fictional Earth-like planet in the remote past or future; or an entirely independent world set in another universe. Many fantasy worlds draw heavily on real world history, geography and sociology, and also on folklore.","totalMediaCount":1543,"slug":"fantasy-world","nsfw":false,"childCount":1},"relationships":{"parent":{"links":{"self":"https://kitsu.io/api/edge/categories/52/relationships/parent","related":"https://kitsu.io/api/edge/categories/52/parent"}},"anime":{"links":{"self":"https://kitsu.io/api/edge/categories/52/relationships/anime","related":"https://kitsu.io/api/edge/categories/52/anime"}},"drama":{"links":{"self":"https://kitsu.io/api/edge/categories/52/relationships/drama","related":"https://kitsu.io/api/edge/categories/52/drama"}},"manga":{"links":{"self":"https://kitsu.io/api/edge/categories/52/relationships/manga","related":"https://kitsu.io/api/edge/categories/52/manga"}}}},{"id":"246","type":"categories","links":{"self":"https://kitsu.io/api/edge/categories/246"},"attributes":{"createdAt":"2018-12-28T19:19:12.049Z","updatedAt":"2021-10-02T01:31:01.031Z","title":"Isekai","description":"An isekai story is one in which the lead characters are transferred to and become stuck or trapped in another world, one completely different from the one they lived in up until the transfer. The new world is commonly a fictional world.  In order to adapt to their new environment, they must use the abilities and knowledge brought from their former world as well as any that may have been bestowed upon them by their brave new world. In some cases, they will seek and eventually find a way to return; in others, they will gleefully embrace their new life.","totalMediaCount":2812,"slug":"isekai","nsfw":false,"childCount":0},"relationships":{"parent":{"links":{"self":"https://kitsu.io/api/edge/categories/246/relationships/parent","related":"https://kitsu.io/api/edge/categories/246/parent"}},"anime":{"links":{"self":"https://kitsu.io/api/edge/categories/246/relationships/anime","related":"https://kitsu.io/api/edge/categories/246/anime"}},"drama":{"links":{"self":"https://kitsu.io/api/edge/categories/246/relationships/drama","related":"https://kitsu.io/api/edge/categories/246/drama"}},"manga":{"links":{"self":"https://kitsu.io/api/edge/categories/246/relationships/manga","related":"https://kitsu.io/api/edge/categories/246/manga"}}}},{"id":"239","type":"categories","links":{"self":"https://kitsu.io/api/edge/categories/239"},"attributes":{"createdAt":"2018-05-16T02:02:06.203Z","updatedAt":"2021-10-02T01:31:02.341Z","title":"Kids","description":"The target audience is children. This does not necessarily mean that the character(s) are children or that an anime whose main character(s) are children is appropriate for this category.","totalMediaCount":2723,"slug":"kids","nsfw":false,"childCount":0},"relationships":{"parent":{"links":{"self":"https://kitsu.io/api/edge/categories/239/relationships/parent","related":"https://kitsu.io/api/edge/categories/239/parent"}},"anime":{"links":{"self":"https://kitsu.io/api/edge/categories/239/relationships/anime","related":"https://kitsu.io/api/edge/categories/239/anime"}},"drama":{"links":{"self":"https://kitsu.io/api/edge/categories/239/relationship