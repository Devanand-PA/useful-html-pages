dge/categories/160/manga"}}}},{"id":"157","type":"categories","links":{"self":"https://kitsu.io/api/edge/categories/157"},"attributes":{"createdAt":"2017-05-31T06:39:23.663Z","updatedAt":"2021-10-02T01:30:59.126Z","title":"Adventure","description":"Adventures are exciting stories, with new experiences or exotic locales. Adventures are designed to provide an action-filled, energetic experience for the viewer. Rather than the predominant emphasis on violence and fighting that is found in pure action anime, however, the viewer of adventures can live vicariously through the travels, conquests, explorations, creation of empires, struggles and situations that confront the main characters, actual historical figures or protagonists. Under the category of adventures, we can include traditional swashbucklers, serialized films, and historical spectacles, searches or expeditions for lost continents, \"jungle\" and \"desert\" epics, treasure hunts and quests, disaster films, and heroic journeys or searches for the unknown. Adventure films are often, but not always, set in an historical period, and may include adapted stories of historical or literary adventure heroes, kings, battles, rebellion, or piracy.","totalMediaCount":10897,"slug":"adventure","nsfw":false,"childCount":0},"relationships":{"parent":{"links":{"self":"https://kitsu.io/api/edge/categories/157/relationships/parent","related":"https://kitsu.io/api/edge/categories/157/parent"}},"anime":{"links":{"self":"https://kitsu.io/api/edge/categories/157/relationships/anime","related":"https://kitsu.io/api/edge/categories/157/anime"}},"drama":{"links":{"self":"https://kitsu.io/api/edge/categories/157/relationships/drama","related":"https://kitsu.io/api/edge/categories/157/drama"}},"manga":{"links":{"self":"https://kitsu.io/api/edge/categories/157/relationships/manga","related":"https://kitsu.io/api/edge/categories/157/manga"}}}},{"id":"156","type":"categories","links":{"self":"https://kitsu.io/api/edge/categories/156"},"attributes":{"createdAt":"2017-05-31T06:39:22.629Z","updatedAt":"2021-10-02T01:30:58.996Z","title":"Fantasy","description":"Fantasy is a genre of fiction that uses magic and other supernatural phenomena as a primary element of plot, theme, or setting. Many works within the genre take place in fictional worlds where magic is common. Fantasy is generally distinguished from science fiction and horror by the expectation that it steers clear of (pseudo-)scientific and macabre themes, respectively, though there is a great deal of overlap between the three (which are subgenres of speculative fiction).\n\nIn popular culture, the genre of fantasy is dominated by its medievalist form, especially since the worldwide success of The Lord of the Rings books by J. R. R. Tolkien. In its broadest sense however, fantasy comprises works by many writers, artists, filmmakers, and musicians, from ancient myths and legends to many recent works embraced by a wide audience today.\n\nFantasy is a vibrant area of academic study in a number of disciplines (English, cultural studies, comparative literature, history, medieval studies). Work in this area ranges widely, from the structuralist theory of Tzvetan Todorov, which emphasizes the fantastic as a liminal space, to work on the connections (political, historical, literary) between medievalism and popular culture\n\nSource: Wiki","totalMediaCount":26598,"slug":"fantasy","nsfw":false,"childCount":10},"relationships":{"parent":{"links":{"self":"https://kitsu.io/api/edge/categories/156/relationships/parent","related":"https://kitsu.io/api/edge/categories/156/parent"}},"anime":{"links":{"self":"https://kitsu.io/api/edge/categories/156/relationships/anime","related":"https://kitsu.io/api/edge/categories/156/anime"}},"drama":{"links":{"self":"https://kitsu.io/api/edge/categories/156/relationships/drama","related":"https://kitsu.io/api/edge/categories/156/drama"}},"manga":{"links":{"self":"https://kitsu.io/api/edge/categories/156/relationships/manga","related":"https://kitsu.io/api/edge/categories/156/manga"}}}},{"id":"158","type":"categories","links":{"self":"https://kitsu.io/api/edge/categories/158"},"attributes":{"createdAt":"2017-05-31T06:39:23.879Z","updatedAt":"2021-10-02T01:30:59.137Z","title":"Horror","description":"The horror cinematic genre is characterized by the attempt to make the viewer experience dread, fear, terror, or horror. Often their plots involve the intrusion of an evil force, event or personage, sometimes of supernatural origin, on the mundane world and the consequences thereof.","totalMediaCount":3033,"slug":"horror","nsfw":false,"childCount":0},"relationships":{"parent":{"links":{"self":"https://kitsu.io/api/edge/categories/158/relationships/parent","related":"https://kitsu.io/api/edge/categories/158/parent"}},"anime":{"links":{"self":"https://kitsu.io/api/edge/categories/158/relationships/anime","related":"https://kitsu.io/api/edge/categories/158/anime"}},"drama":{"links":{"self":"https://kitsu.io/api/edge/categories/158/relationships/drama","related":"https://kitsu.io/api/edge/categories/158/drama"}},"manga":{"links":{"self":"https://kitsu.io/api/edge/categories/158/relationships/manga","related":"https://kitsu.io/api/edge/categories/158/manga"}}}},{"id":"25","type":"categories","links":{"self":"https://kitsu.io/api/edge/categories/25"},"attributes":{"createdAt":"2017-05-31T06:38:36.191Z","updatedAt":"2021-10-02T01:30:59.023Z","title":"Magic","description":"Magic is the art of purportedly manipulating aspects of reality either by supernatural means or through knowledge of unknown occult laws.","totalMediaCount":4077,"slug":"magic","nsfw":false,"childCount":0},"relationships":{"parent":{"links":{"self":"https://kitsu.io/api/edge/categories/25/relationships/parent","related":"https://kitsu.io/api/edge/categories/25/parent"}},"anime":{"links":{"self":"https://kitsu.io/api/edge/categories/25/relationships/anime","related":"https://kitsu.io/api/edge/categories/25/anime"}},"drama":{"links":{"