/edge/categories/155/anime"}},"drama":{"links":{"self":"https://kitsu.io/api/edge/categories/155/relationships/drama","related":"https://kitsu.io/api/edge/categories/155/drama"}},"manga":{"links":{"self":"https://kitsu.io/api/edge/categories/155/relationships/manga","related":"https://kitsu.io/api/edge/categories/155/manga"}}}},{"id":"197","type":"categories","links":{"self":"https://kitsu.io/api/edge/categories/197"},"attributes":{"createdAt":"2017-05-31T06:39:31.234Z","updatedAt":"2021-10-02T01:31:01.479Z","title":"Post Apocalypse","description":"An anime that takes place on future Earth (or it could be an alternative universe) after a major cataclysm has occurred. World War III, an alien invasion, plague, global warming or some other general disaster are common themes to build a post-apocalyptic world upon, where the effects were severe enough that mankind barely survived.The time frame may be immediately after the catastrophe, focusing on the travails or psychology of survivors, or considerably later, often including the theme that the existence of pre-catastrophe civilization has been forgotten (or mythologised). Post-apocalyptic stories often take place in an agrarian, non-technological future world, or a world where only scattered elements of technology remain. There is a considerable degree of blurring between post-apocalyptic fiction and that which deals with false utopias or dystopian societies.","totalMediaCount":526,"slug":"post-apocalypse","nsfw":false,"childCount":0},"relationships":{"parent":{"links":{"self":"https://kitsu.io/api/edge/categories/197/relationships/parent","related":"https://kitsu.io/api/edge/categories/197/parent"}},"anime":{"links":{"self":"https://kitsu.io/api/edge/categories/197/relationships/anime","related":"https://kitsu.io/api/edge/categories/197/anime"}},"drama":{"links":{"self":"https://kitsu.io/api/edge/categories/197/relationships/drama","related":"https://kitsu.io/api/edge/categories/197/drama"}},"manga":{"links":{"self":"https://kitsu.io/api/edge/categories/197/relationships/manga","related":"https://kitsu.io/api/edge/categories/197/manga"}}}},{"id":"150","type":"categories","links":{"self":"https://kitsu.io/api/edge/categories/150"},"attributes":{"createdAt":"2017-05-31T06:39:20.357Z","updatedAt":"2021-10-02T01:30:58.454Z","title":"Action","description":"Action anime usually involve a fairly straightforward story of good guys versus bad guys, where most disputes are resolved by using physical force. It often contains a lot of shooting, explosions and fighting.","totalMediaCount":18466,"slug":"action","nsfw":false,"childCount":5},"relationships":{"parent":{"links":{"self":"https://kitsu.io/api/edge/categories/150/relationships/parent","related":"https://kitsu.io/api/edge/categories/150/parent"}},"anime":{"links":{"self":"https://kitsu.io/api/edge/categories/150/relationships/anime","related":"https://kitsu.io/api/edge/categories/150/anime"}},"drama":{"links":{"self":"https://kitsu.io/api/edge/categories/150/relationships/drama","related":"https://kitsu.io/api/edge/categories/150/drama"}},"manga":{"links":{"self":"https://kitsu.io/api/edge/categories/150/relationships/manga","related":"https://kitsu.io/api/edge/categories/150/manga"}}}},{"id":"160","type":"categories","links":{"self":"https://kitsu.io/api/edge/categories/160"},"attributes":{"createdAt":"2017-05-31T06:39:23.938Z","updatedAt":"2021-10-02T01:30:59.176Z","title":"Comedy","description":"Anime whose central struggle causes hilarious results. These stories are built upon funny characters, situations and events. A comedy anime is laced with humour and sets out to provoke laughter from the audience.\n\nJapanese humour can be a bit strange to westerners, so if you're new to this type of humour, just bear with it; it'll most likely grow on you if you're a fan of other kinds of comedy.","totalMediaCount":25974,"slug":"comedy","nsfw":false,"childCount":6},"relationships":{"parent":{"links":{"self":"https://kitsu.io/api/edge/categories/160/relationships/parent","related":"https://kitsu.io/api/edge/categories/160/parent"}},"anime":{"links":{"self":"https://kitsu.io/api/edge/categories/160/relationships/anime","related":"https://kitsu.io/api/edge/categories/160/anime"}},"drama":{"links":{"self":"https://kitsu.io/api/edge/categories/160/relationships/drama","related":"https://kitsu.io/api/edge/categories/160/drama"}},"manga":{"links":{"self":"https://kitsu.io/api/edge/categories/160/relationships/manga","related":"https://kitsu.io/api/edge/categories/160/manga"}}}},{"id":"44","type":"categories","links":{"self":"https://kitsu.io/api/edge/categories/44"},"attributes":{"createdAt":"2017-05-31T06:38:46.860Z","updatedAt":"2021-10-02T01:30:58.483Z","title":"Gunfights","description":"Fights where two or more parties are firing guns at one another.","totalMediaCount":316,"slug":"gunfights","nsfw":false,"childCount":0},"relationships":{"parent":{"links":{"self":"https://kitsu.io/api/edge/categories/44/relationships/parent","related":"https://kitsu.io/api/edge/categories/44/parent"}},"anime":{"links":{"self":"https://kitsu.io/api/edge/categories/44/relationships/anime","related":"https://kitsu.io/api/edge/categories/44/anime"}},"drama":{"links":{"self":"https://kitsu.io/api/edge/categories/44/relationships/drama","related":"https://kitsu.io/api/edge/categories/44/drama"}},"manga":{"links":{"self":"https://kitsu.io/api/edge/categories/44/relationships/manga","related":"https://kitsu.io/api/edge/categories/44/manga"}}}},{"id":"153","type":"categories","links":{"self":"https://kitsu.io/api/edge/categories/153"},"attributes":{"createdAt":"2017-05-31T06:39:20.439Z","updatedAt":"2021-10-02T01:30:58.589Z","title":"Angst","description":"A feeling of general discomfort and uneasiness is present due to either trivial or more serious reasons, often accompanied by depression.\n\nWarning: may contain copious amounts of brooding and sighing.\n\nEtymology: \"Angst\" is a German word meaning fear or anxiety.","totalMediaCount":310,"slug":"angst","nsfw":false,"childCount":0},"relationships":{"parent":{"links":{"self":"https://kitsu.io/api/edge/categories/153/relationships/parent","related":"https://kitsu.io/api/edge/categories/153/parent"}},"anime":{"links":{"self":"https://kitsu.io/api/edge/categories/153/relationships/anime","related":"https://kitsu.io/api/edge/categories/153/anime"}},"drama":{"links":{"self":"https://kitsu.io/api/edge/categories/153/relationships/drama","related":"https://kitsu.io/api/edge/categories/153/drama"}},"manga":{"links":{"self":"https://kitsu.io/api/edge/categories/153/relationships/manga","related":"https://kitsu.io/api/edge/categories/153/manga"}}}},{"id":"77","type":"categories","links":{"self":"https://kitsu.io/api/edge/categories/77"},"attributes":{"createdAt":"2017-05-31T06:38:50.800Z","updatedAt":"2021-10-02T01:31:00.454Z","title":"Other Planet","description":"The anime will fit this category if some or all of the action takes place on another planet which is supposedly in the same universe as Earth, not a complete fantasy world; usually there has to be some concept of space travel. The Latin name for Earth - Terra, would also pass the condition of being in the same universe as Earth. Basically, even mentioning of Earth existing or having existed would be enough. Although Moon is a moon, it also qualifies as Other Planet.","totalMediaCount":204,"slug":"other-planet","nsfw":false,"childCount":1},"relationships":{"parent":{"links":{"self":"https://kitsu.io/api/edge/categories/77/relationships/parent","related":"https://kitsu.io/api/edge/categories/77/parent"}},"anime":{"links":{"self":"https://kitsu.io/api/edge/categories/77/relationships/anime","related":"https://kitsu.io/api/edge/categories/77/anime"}},"drama":{"links":{"self":"https://kitsu.io/api/edge/categories/77/relationships/drama","related":"https://kitsu.io/api/edge/categories/77/drama"}},"manga":{"links":{"self":"https://kitsu.io/api/edge/categories/77/relationships/manga","related":"https://kitsu.io/api/edge/categories/77/manga"}}}},{"id":"119","type":"categories","links":{"self":"https://kitsu.io/api/edge/categories/119"},"attributes":{"createdAt":"2017-05-31T06:39:08.241Z","updatedAt":"2021-10-02T01:30:58.643Z","title":"Humanoid Alien","description":"Humanoids are aliens, intelligent beings who do not originate from Earth, but have a striking similarity to humans or at least show the basic body layout, i.e. two arms and legs, head with two eyes and ears, one nose and mouth. Though the latter - head-related features - may vary. As \"DearS\" shows some aliens actually exhibit super-human beauty, or as in the case of \"Onegai Teacher\" they are genetically compatible to humans for some strange reason.","totalMediaCount":262,"slug":"humanoid-alien","nsfw":false,"childCount":0},"relationships":{"parent":{"links":{"self":"https://kitsu.io/api/edge/categories/119/relationships/parent","related":"https://kitsu.io/api/edge/categories/119/parent"}},"anime":{"links":{"self":"https://kitsu.io/api/edge/categories/119/relationships/anime","related":"https://kitsu.io/api/edge/categories/119/anime"}},"drama":{"links":{"self":"https://kitsu.io/api/edge/categories/119/relationships/drama","related":"https://kitsu.io/api/edge/categories/119/drama"}},"manga":{"links":{"self":"https://kitsu.io/api/edge/categories/119/relationships/manga","related":"https://kitsu.io/api/edge/categories/119/manga"}}}},{"id":"27","type":"categories","links":{"self":"https://kitsu.io/api/edge/categories/27"},"attributes":{"createdAt":"2017-05-31T06:38:37.214Z","updatedAt":"2021-10-02T01:30:58.647Z","title":"Alien","description":"This entity or creature was born on another world than the main characters.","totalMediaCount":528,"slug":"alien","nsfw":false,"childCount":1},"relationships":{"parent":{"links":{"self":"https://kitsu.io/api/edge/categories/27/relationships/parent","related":"https://kitsu.io/api/edge/categories/27/parent"}},"anime":{"links":{"self":"https://kitsu.io/api/edge/c