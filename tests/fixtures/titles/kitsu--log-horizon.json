u.io/api/edge/categories/160/anime"}},"drama":{"links":{"self":"https://kitsu.io/api/edge/categories/160/relationships/drama","related":"https://kitsu.io/api/edge/categories/160/drama"}},"manga":{"links":{"self":"https://kitsu.io/api/edge/categories/160/relationships/manga","related":"https://kitsu.io/api/edge/categories/160/manga"}}}},{"id":"150","type":"categories","links":{"self":"https://kitsu.io/api/edge/categories/150"},"attributes":{"createdAt":"2017-05-31T06:39:20.357Z","updatedAt":"2021-10-02T01:30:58.454Z","title":"Action","description":"Action anime usually involve a fairly straightforward story of good guys versus bad guys, where most disputes are resolved by using physical force. It often contains a lot of shooting, explosions and fighting.","totalMediaCount":18466,"slug":"action","nsfw":false,"childCount":5},"relationships":{"parent":{"links":{"self":"https://kitsu.io/api/edge/categories/150/relationships/parent","related":"https://kitsu.io/api/edge/categories/150/parent"}},"anime":{"links":{"self":"https://kitsu.io/api/edge/categories/150/relationships/anime","related":"https://kitsu.io/api/edge/categories/150/anime"}},"drama":{"links":{"self":"https://kitsu.io/api/edge/categories/150/relationships/drama","related":"https://kitsu.io/api/edge/categories/150/drama"}},"manga":{"links":{"self":"https://kitsu.io/api/edge/categories/150/relationships/manga","related":"https://kitsu.io/api/edge/categories/150/manga"}}}},{"id":"156","type":"categories","links":{"self":"https://kitsu.io/api/edge/categories/156"},"attributes":{"createdAt":"2017-05-31T06:39:22.629Z","updatedAt":"2021-10-02T01:30:58.996Z","title":"Fantasy","description":"Fantasy is a genre of fiction that uses magic and other supernatural phenomena as a primary element of plot, theme, or setting. Many works within the genre take place in fictional worlds where magic is common. Fantasy is generally distinguished from science fiction and horror by the expectation that it steers clear of (pseudo-)scientific and macabre themes, respectively, though there is a great deal of overlap between the three (which are subgenres of speculative fiction).\n\nIn popular culture, the genre of fantasy is dominated by its medievalist form, especially since the worldwide success of The Lord of the Rings books by J. R. R. Tolkien. In its broadest sense however, fantasy comprises works by many writers, artists, filmmakers, and musicians, from ancient myths and legends to many recent works embraced by a wide audience today.\n\nFantasy is a vibrant area of academic study in a number of disciplines (English, cultural studies, comparative literature, history, medieval studies). Work in this area ranges widely, from the structuralist theory of Tzvetan Todorov, which emphasizes the fantastic as a liminal space, to work on the connections (political, historical, literary) between medievalism and popular culture\n\nSource: Wiki","totalMediaCount":26598,"slug":"fantasy","nsfw":false,"childCount":10},"relationships":{"parent":{"links":{"self":"https://kitsu.io/api/edge/categories/156/relationships/parent","related":"https://kitsu.io/api/edge/categories/156/parent"}},"anime":{"links":{"self":"https://kitsu.io/api/edge/categories/156/relationships/anime","related":"https://kitsu.io/api/edge/categories/156/anime"}},"drama":{"links":{"self":"https://kitsu.io/api/edge/categories/156/relationships/drama","related":"https://kitsu.io/api/edge/categories/156/drama"}},"manga":{"links":{"self":"https://kitsu.io/api/edge/categories/156/relationships/manga","related":"https://kitsu.io/api/edge/categories/156/manga"}}}},{"id":"25","type":"categories","links":{"self":"https://kitsu.io/api/edge/categories/25"},"attributes":{"createdAt":"2017-05-31T06:38:36.191Z","updatedAt":"2021-10-02T01:30:59.023Z","title":"Magic","description":"Magic is the art of purportedly manipulating aspects of reality either by supernatural means or through knowledge of unknown occult laws.","totalMediaCount":4077,"slug":"magic","nsfw":false,"childCount":0},"relationships":{"parent":{"links":{"self":"https://kitsu.io/api/edge/categories/25/relationships/parent","related":"https://kitsu.io/api/edge/categories/25/parent"}},"anime":{"links":{"self":"https://kitsu.io/api/edge/categories/25/relationships/anime","related":"https://kitsu.io/api/edge/categories/25/anime"}},"drama":{"links":{"self":"https://kitsu.io/api/edge/categories/25/relationships/drama","related":"https://kitsu.io/api/edge/categories/25/drama"}},"manga":{"links":{"self":"https://kitsu.io/api/edge/categories/25/relationships/manga","related":"https://kitsu.io/api/edge/categories/25/manga"}}}},{"id":"171","type":"categories","links":{"self":"https://kitsu.io/api/edge/categories/171"},"attributes":{"createdAt":"2017-05-31T06:39:25.651Z","updatedAt":"2021-10-02T01:31:01.164Z","title":"Politics","description":"From commies to fat capitalist pigs, all the stuff done by the \"guys with the power\", mainly evil tactics for gaining more power over the masses.\n\nWatching this title may remind you why CNN is boring.","totalMediaCount":205,"slug":"politics","nsfw":false,"childCount":0},"relationships":{"parent":{"links":{"self":"https://kitsu.io/api/edge/categories/171/relationships/parent","related":"https://kitsu.io/api/edge/categories/171/parent"}},"anime":{"links":{"self":"https://kitsu.io/api/edge/categories/171/relationships/anime","related":"https://kitsu.io/api/edge/categories/171/anime"}},"drama":{"links":{"self":"https://kitsu.io/api/edge/categories/171/relationships/drama","related":"https://kitsu.io/api/edge/categories/171/drama"}},"manga":{"links":{"self":"https://kitsu.io/api/edge/categories/171/relationships/manga","related":"https://kitsu.io/api/edge/categories/171/manga"}}}},{"id":"148","type":"categories","links":{"self":"https://kitsu.io/api/edge/categories/148"},"attributes":{"createdAt":"2017-05-31T06:39:20.295Z","updatedAt":"2021-10-02T01:30:58.431Z","title":"Virtual Reality","description":"A virtual reality is a place where the character interacts with a computer (or some other device)-simulated environment, be it real or imagined. The condition for a virtual reality to exist is the existence of real world for the character. In some cases, a virtual reality where characters can get harmed physically is depicted.","totalMediaCount":577,"slug":"virtual-reality","nsfw":false,"childCount":0},"relationships":{"parent":{"links":{"self":"https://kitsu.io/api/edge/categories/148/relationships/parent","related":"https://kitsu.io/api/edge/categories/148/parent"}},"anime":{"links":{"self":"https://kitsu.io/api/edge/categories/148/relationships/anime","related":"https://kitsu.io/api/edge/categories/148/anime"}},"drama":{"links":{"self":"https://kitsu.io/api/edge/categories/148/relationships/drama","related":"https://kitsu.io/api/edge/categories/148/drama"}},"manga":{"links":{"self":"https://kitsu.io/api/edge/categories/148/relationships/manga","related":"https://kitsu.io/api/edge/categories/148/manga"}}}},{"id":"157","type":"categories","links":{"self":"https://kitsu.io/api/edge/categories/157"},"attributes":{"createdAt":"2017-05-31T06:39:23.663Z","updatedAt":"2021-10-02T01:30:59.126Z","title":"Adventure","description":"Adventures are exciting stories, with new experiences or exotic locales. Adventures are designed to provide an action-filled, energetic experience for the viewer. Rather than the predominant emphasis on violence and fighting that is found in pure action anime, however, the viewer of adventures can live vicariously through the travels, conquests, explorations, creation of empires, struggles and situations that confront the main characters, actual historical figures or protagonists. Under the category of adventures, we can include traditional swashbucklers, serialized films, and historical spectacles, searches or expeditions for lost continents, \"jungle\" and \"desert\" epics, treasure hunts and quests, disaster films, and heroic journeys or searches for the unknown. Adventure films are often, but not always, set in an historical period, and may include adapted stories of historical or literary adventure heroes, kings, battles, rebellion, or piracy.","totalMediaCount":10897,"slug":"adventure","nsfw":false,"childCount":0},"relationships":{"parent":{"links":{"self":"https://kitsu.io/api/edge/categories/157/relationships/parent","related":"https://kitsu.io/api/edge/categories/157/parent"}},"anime":{"links":{"self":"https://kitsu.io/api/edge/categories/157/relationships/anime","related":"https://kitsu.io/api/edge/categories/157/anime"}},"drama":{"links":{"self":"https://kitsu.io/api/edge/categories/157/relationships/drama","related":"https://kitsu.io/api/edge/categories/157/drama"}},"manga":{"links":{"self":"https://kitsu.io/api/edge/categories/157/relationships/manga","related":"https://kitsu.io/api/edge/categories/157/manga"}}}},{"id":"246","type":"categories","links":{"self":"https://kitsu.io/api/edge/categories/246"},"attributes":{"createdAt":"2018-12-28T19:19:12.049Z","updatedAt":"2021-10-02T01:31:01.031Z","title":"Isekai","description":"An isekai story is one in which the lead characters are transferred to and become stuck or trapped in another world, one completely different from the one they lived in up until the transfer. The new world is commonly a fictional world.  In order to adapt to their new environment, they must use the abilities and knowledge brought from their former world as well as any that may have been bestowed upon them by their brave new world. In some cases, they will seek and eventually find a way to return; in others, they will gleefully embrace their new life.","totalMediaCount":2812,"slug":"isekai","nsfw":false,"childCount":0},"relationships":{"parent":{"links":{"self":"https://kitsu.io/api/edge/categories/246/relationships/parent","related":"https://kitsu.io/api/edge/categories/246/parent"}},"anime":{"links":{"self":"https://kitsu.io/api/edge/categories/246/relationships/anime","related":"https://kitsu.io/api/edge/categories/246/anime"}},"drama":{"links":{"self":"https://kitsu.io/api/edge/categories/246/relationships/drama","related":"https://kitsu.io/api/edge/categories/246/drama"}},"manga":{"links":{"self":"https://kitsu.io/api/edge/categories/246/relationships/manga","related":"https://kitsu.io/api/edge/categories/246/manga"}}}},{"id":"52","type":"categories","links":{"self":"https://kitsu.io/api/edge/categories/52"},"attributes":{"createdAt":"2017-05-31T06:38:47.099Z","updatedAt":"2021-10-02T01:31:00.535Z","title":"Fantasy World","description":"A fantasy world is a type of imaginary world, part of a fictional universe. Typical worlds involve, but are not limited to magic or magical abilities and a medieval theme. Some examples include: a parallel world tenuously connected to Earth via magical portals or items; a fictional Earth-like planet in the remote past or future; or an entirely independent world set in another universe. Many fantasy worlds draw heavily on real world history, geography and sociology, and also on folklore.","totalMediaCount":1543,"slug":"fantasy-world","nsfw":false,"childCount":1},"relationships":{"parent":{"links":{"self":"https://kitsu.io/api/edge/categories/52/relationships/parent","related":"https://kitsu.io/api/edge/categories/52/parent"}},"anime":{"links":{"self":"https://kitsu.io/api/edge/categories/52/relationships/anime","related":"https://kitsu.io/api/edge/categories/52/anime"}},"drama":{"links":{"self":"https://kitsu.io/api/edge/categories/52/relationships/drama","related":"https://kitsu.io/api/edge/categories/52/drama"}},"manga":{"links":{"self":"https://kitsu.io/api/edge/categories/52/relationships/manga","related":"https://kitsu.io/api/edge/categories/52/manga"}}}}],"meta":{"count":4},"links":{"first":"https://kitsu.io/api/edge/anime?filter%5Btext%5D=Log+Horizon&include=genres%2Ccategories&page%5Blimit%5D=3&page%5Boffset%5D=0","next":"https://kitsu.io/api/edge/anime?filter%5Btext%5D=Log+Horizon&include=genres%2Ccategories&page%5B