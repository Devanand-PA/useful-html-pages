elationships":{"parent":{"links":{"self":"https://kitsu.io/api/edge/categories/155/relationships/parent","related":"https://kitsu.io/api/edge/categories/155/parent"}},"anime":{"links":{"self":"https://kitsu.io/api/edge/categories/155/relationships/anime","related":"https://kitsu.io/api/edge/categories/155/anime"}},"drama":{"links":{"self":"https://kitsu.io/api/edge/categories/155/relationships/drama","related":"https://kitsu.io/api/edge/categories/155/drama"}},"manga":{"links":{"self":"https://kitsu.io/api/edge/categories/155/relationships/manga","related":"https://kitsu.io/api/edge/categories/155/manga"}}}},{"id":"156","type":"categories","links":{"self":"https://kitsu.io/api/edge/categories/156"},"attributes":{"createdAt":"2017-05-31T06:39:22.629Z","updatedAt":"2021-10-02T01:30:58.996Z","title":"Fantasy","description":"Fantasy is a genre of fiction that uses magic and other supernatural phenomena as a primary element of plot, theme, or setting. Many works within the genre take place in fictional worlds where magic is common. Fantasy is generally distinguished from science fiction and horror by the expectation that it steers clear of (pseudo-)scientific and macabre themes, respectively, though there is a great deal of overlap between the three (which are subgenres of speculative fiction).\n\nIn popular culture, the genre of fantasy is dominated by its medievalist form, especially since the worldwide success of The Lord of the Rings books by J. R. R. Tolkien. In its broadest sense however, fantasy comprises works by many writers, artists, filmmakers, and musicians, from ancient myths and legends to many recent works embraced by a wide audience today.\n\nFantasy is a vibrant area of academic study in a number of disciplines (English, cultural studies, comparative literature, history, medieval studies). Work in this area ranges widely, from the structuralist theory of Tzvetan Todorov, which emphasizes the fantastic as a liminal space, to work on the connections (political, historical, literary) between medievalism and popular culture\n\nSource: Wiki","totalMediaCount":26598,"slug":"fantasy","nsfw":false,"childCount":10},"relationships":{"parent":{"links":{"self":"https://kitsu.io/api/edge/categories/156/relationships/parent","related":"https://kitsu.io/api/edge/categories/156/parent"}},"anime":{"links":{"self":"https://kitsu.io/api/edge/categories/156/relationships/anime","related":"https://kitsu.io/api/edge/categories/156/anime"}},"drama":{"links":{"self":"https://kitsu.io/api/edge/categories/156/relationships/drama","related":"https://kitsu.io/api/edge/categories/156/drama"}},"manga":{"links":{"self":"https://kitsu.io/api/edge/categories/156/relationships/manga","related":"https://kitsu.io/api/edge/categories/156/manga"}}}},{"id":"184","type":"categories","links":{"self":"https://kitsu.io/api/edge/categories/184"},"attributes":{"createdAt":"2017-05-31T06:39:28.357Z","updatedAt":"2021-10-02T01:30:59.565Z","title":"Drama","description":"Drama is a form of narrative fiction (or semi-fiction) intended to be more serious than humorous in tone.","totalMediaCount":18102,"slug":"drama","nsfw":false,"childCount":0},"relationships":{"parent":{"links":{"self":"https://kitsu.io/api/edge/categories/184/relationships/parent","related":"https://kitsu.io/api/edge/categories/184/parent"}},"anime":{"links":{"self":"https://kitsu.io/api/edge/categories/184/relationships/anime","related":"https://kitsu.io/api/edge/categories/184/anime"}},"drama":{"links":{"self":"https://kitsu.io/api/edge/categories/184/relationships/drama","related":"https://kitsu.io/api/edge/categories/184/drama"}},"manga":{"links":{"self":"https://kitsu.io/api/edge/categories/184/relationships/manga","related":"https://kitsu.io/api/edge/categories/184/manga"}}}},{"id":"157","type":"categories","links":{"self":"https://kitsu.io/api/edge/categories/157"},"attributes":{"createdAt":"2017-05-31T06:39:23.663Z","updatedAt":"2021-10-02T01:30:59.126Z","title":"Adventure","description":"Adventures are exciting stories, with new experiences or exotic locales. Adventures are designed to provide an action-filled, energetic experience for the viewer. Rather than the predominant emphasis on violence and fighting that is found in pure action anime, however, the viewer of adventures can live vicariously through the travels, conquests, explorations, creation of empires, struggles and situations that confront the main characters, actual historical figures or protagonists. Under the category of adventures, we can include traditional swashbucklers, serialized films, and historical spectacles, searches or expeditions for lost continents, \"jungle\" and \"desert\" epics, treasure hunts and quests, disaster films, and heroic journeys or searches for the unknown. Adventure films are often, but not always, set in an historical period, and may include adapted stories of historical or literary adventure heroes, kings, battles, rebellion, or piracy.","totalMediaCount":10897,"slug":"adventure","nsfw":false,"childCount":0},"relationships":{"parent":{"links":{"self":"https://kitsu.io/api/edge/categories/157/relationships/parent","related":"https://kitsu.io/api/edge/categories/157/parent"}},"anime":{"links":{"self":"https://kitsu.io/api/edge/categories/157/relationships/anime","related":"https://kitsu.io/api/edge/categories/157/anime"}},"drama":{"links":{"self":"https://kitsu.io/api/edge/categories/157/relationships/drama","related":"https://kitsu.io/api/edge/categories/157/drama"}},"manga":{"links":{"self":"https://kitsu.io/api/edge/categories/157/relationships/manga","related":"https://kitsu.io/api/edge/categories/157/manga"}}}},{"id":"70","type":"categories","links":{"self":"https://kitsu.io/api/edge/categories/70"},"attributes":{"createdAt":"2017-05-31T06:38:49.979Z","updatedAt":"2021-10-02T01:30:59.110Z","title":"Dark Fantasy","description":"Focus set on darker themes in a fantasy setting, sometimes leaning towards horror elements. Bleak and pessimistic tones often dominate. Dark supernatural beings like vampires may play a significant role.","totalMediaCount":185,"slug":"dark-fantasy","nsfw":false,"childCount":0},"relationships":{"parent":{"links":{"self":"https://kitsu.io/api/edge/categories/70/relationships/parent","related":"https://kitsu.io/api/edge/categories/70/parent"}},"anime":{"links":{"self":"https://kitsu.io/api/edge/categories/70/relationships/anime","related":"https://kitsu.io/api/edge/categories/70/anime"}},"drama":{"links":{"self":"https://kitsu.io/api/edge/categories/70/relationships/drama","related":"https://kitsu.io/api/edge/categories/70/drama"}},"manga":{"links":{"self":"https://kitsu.io/api/edge/categories/70/relationships/manga","related":"https://kitsu.io/api/edge/categories/70/manga"}}}},{"id":"232","type":"categories","links":{"self":"https://kitsu.io/api/edge/categories/232"},"attributes":{"createdAt":"2017-06-07T19:38:10.577Z","updatedAt":"2021-10-02T01:30:59.608Z","title":"Psychological","description":"Psychological media delve into mental or emotional states of a character in the midst of a difficult situation, letting you observe them change as tension increases. Internal monologues are a key feature, allowing narration to delve into a character's mind, revealing their innermost ideas and motivations - even as they may be driven to the brink of sanity.","totalMediaCount":3514,"slug":"psychological","nsfw":false,"childCount":2},"relationships":{"parent":{"links":{"self":"https://kitsu.io/api/edge/categories/232/relationships/parent","related":"https://kitsu.io/api/edge/categories/232/parent"}},"anime":{"links":{"self":"https://kitsu.io/api/edge/categories/232/relationships/anime","related":"https://kitsu.io/api/edge/categories/232/anime"}},"drama":{"links":{"self":"https://kitsu.io/api/edge/categories/232/relationships/drama","related":"https://kitsu.io/api/edge/categories/232/drama"}},"manga":{"links":{"self":"https://kitsu.io/api/edge/categories/232/relationships/manga","related":"https://kitsu.io/api/edge/categories/232/manga"}}}},{"id":"5","type":"categories","links":{"self":"https://kitsu.io/api/edge/categories/5"},"attributes":{"createdAt":"2017-05-31T06:38:28.792Z","updatedAt":"2021-10-02T01:30:58.806Z","title":"Android","description":"An android is a robot or synthetic organism designed to look and act like a human.","totalMediaCount":235,"slug":"android","nsfw":false,"childCount":0},"relationships":{"parent":{"links":{"self":"https://kitsu.io/api/edge/categories/5/relationships/parent","related":"https://kitsu.io/api/edge/categories/5/parent"}},"anime":{"links":{"self":"https://kitsu.io/api/edge/categories/5/relationships/anime","related":"https://kitsu.io/api/edge/categories/5/anime"}},"drama":{"links":{"self":"https://kitsu.io/api/edge/categories/5/relationships/drama","related":"https://kitsu.io/api/edge/categories/5/drama"}},"manga":{"links":{"self":"https://kitsu.io/api/edge/categories/5/relationships/manga","related":"https://kitsu.io/api/edge/categories/5/manga"}}}},{"id":"57","type":"categories","links":{"self":"https://kitsu.io/api/edge/categories/57"},"attributes":{"createdAt":"2017-05-31T06:38:48.889Z","updatedAt":"2021-10-02T01:30:58.692Z","title":"Human Enhancement","description":"The enhancement of humans can take various forms: It can be something comparatively non-intrusive as a power-up drug, a form of machine implantation or cyberization (\"SAC Solid State Society\"), or outright - possibly atrocious - genetic manipulation (\"Ao no 6-gou\"). Plot-wise enhanced protagonists in anime usually have to pay a price for their enhancements, be it physical or mental.","totalMediaCount":170,"slug":"human-enhancement","nsfw":false,"childCount":2},"relationships":{"parent":{"links":{"self":"https://kitsu.io/api/edge/categories/57/relationships/parent","related":"https://kitsu.io/api/edge/categories/57/parent"}},"anime":{"links":{"self":"https://kitsu.io/api/edge/categories/57/relationships/anime","related":"https://kitsu.io/api/edge/categorie