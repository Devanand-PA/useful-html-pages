nships/manga","related":"https://kitsu.io/api/edge/categories/150/manga"}}}},{"id":"155","type":"categories","links":{"self":"https://kitsu.io/api/edge/categories/155"},"attributes":{"createdAt":"2017-05-31T06:39:22.090Z","updatedAt":"2021-10-02T01:30:58.633Z","title":"Science Fiction","description":"Science fiction stories usually focus on how situations could be different in the future when we are more technologically advanced; due to either our own achievements or having met with other civilizations whom we have learned from.","totalMediaCount":6966,"slug":"science-fiction","nsfw":false,"childCount":8},"relationships":{"parent":{"links":{"self":"https://kitsu.io/api/edge/categories/155/relationships/parent","related":"https://kitsu.io/api/edge/categories/155/parent"}},"anime":{"links":{"self":"https://kitsu.io/api/edge/categories/155/relationships/anime","related":"https://kitsu.io/api/edge/categories/155/anime"}},"drama":{"links":{"self":"https://kitsu.io/api/edge/categories/155/relationships/drama","related":"https://kitsu.io/api/edge/categories/155/drama"}},"manga":{"links":{"self":"https://kitsu.io/api/edge/categories/155/relationships/manga","related":"https://kitsu.io/api/edge/categories/155/manga"}}}},{"id":"175","type":"categories","links":{"self":"https://kitsu.io/api/edge/categories/175"},"attributes":{"createdAt":"2017-05-31T06:39:27.123Z","updatedAt":"2021-10-02T01:31:01.385Z","title":"Crime","description":"Stories about crimes and the people who commit them.","totalMediaCount":564,"slug":"crime","nsfw":false,"childCount":5},"relationships":{"parent":{"links":{"self":"https://kitsu.io/api/edge/categories/175/relationships/parent","related":"https://kitsu.io/api/edge/categories/175/parent"}},"anime":{"links":{"self":"https://kitsu.io/api/edge/categories/175/relationships/anime","related":"https://kitsu.io/api/edge/categories/175/anime"}},"drama":{"links":{"self":"https://kitsu.io/api/edge/categories/175/relationships/drama","related":"https://kitsu.io/api/edge/categories/175/drama"}},"manga":{"links":{"self":"https://kitsu.io/api/edge/categories/175/relationships/manga","related":"https://kitsu.io/api/edge/categories/175/manga"}}}},{"id":"181","type":"categories","links":{"self":"https://kitsu.io/api/edge/categories/181"},"attributes":{"createdAt":"2017-05-31T06:39:27.895Z","updatedAt":"2021-10-02T01:31:02.212Z","title":"Dystopia","description":"A dystopia (from Ancient Greek: δυσ-, \"bad, ill\", and Ancient Greek: τόπος, \"place, landscape\"; alternatively cacotopia, or anti-utopia) is, in literature, an often futuristic society that has degraded into a repressive and controlled state, often under the guise of being utopian. Dystopian literature has underlying cautionary tones, warning society that if we continue to live how we do, this will be the consequence. A dystopia, thus, is regarded as a sort of negative utopia and is often characterized by an authoritarian or totalitarian form of government. Dystopias usually feature different kinds of repressive social control systems, a lack or total absence of individual freedoms and expressions and constant states of warfare or violence. Dystopias often explore the concept of humans abusing technology and how humans individually and collectively cope with technology that has evolved too quickly such as the car, the flamethrower or the microwave. A dystopian society is also often characterized by widespread poverty and brutal political controls such as a large military-like police.","totalMediaCount":176,"slug":"dystopia","nsfw":false,"childCount":0},"relationships":{"parent":{"links":{"self":"https://kitsu.io/api/edge/categories/181/relationships/parent","related":"https://kitsu.io/api/edge/categories/181/parent"}},"anime":{"links":{"self":"https://kitsu.io/api/edge/categories/181/relationships/anime","related":"https://kitsu.io/api/edge/categories/181/anime"}},"drama":{"links":{"self":"https://kitsu.io/api/edge/categories/181/relationships/drama","related":"https://kitsu.io/api/edge/categories/181/drama"}},"manga":{"links":{"self":"https://kitsu.io/api/edge/categories/181/relationships/manga","related":"https://kitsu.io/api/edge/categories/181/manga"}}}},{"id":"26","type":"categories","links":{"self":"https://kitsu.io/api/edge/categories/26"},"attributes":{"createdAt":"2017-05-31T06:38:36.891Z","updatedAt":"2021-10-02T01:30:58.686Z","title":"Cyborg","description":"A cyborg is a cybernetic organism (i.e. an organism that has both artificial and natural systems). The term was coined in 1960 when Manfred Clynes and Nathan Kline used it in an article about the advantages of self-regulating human-machine systems in outer space. D. S. Halacy's Cyborg: Evolution of the Superman in 1965 featured an introduction which spoke of a \"new frontier\" that was \"not merely space, but more profoundly the relationship between 'inner space' to 'outer space' -a bridge...between mind and matter.\" The cyborg is often seen today merely as an organism that has enhanced abilities due to technology, but this perhaps oversimplifies the category of feedback.\n\nFictional cyborgs are portrayed as a synthesis of organic and synthetic parts, and frequently pose the question of difference between human and machine as one concerned with morality, free will, and empathy. Fictional cyborgs may be represented as visibly mechanical (e.g. the Cybermen in the Doctor Who franchise or The Borg from Star Trek); or as almost indistinguishable from humans (e.g. the \"Human\" Cylons from the re-imagining of Battlestar Galactica). The 1970s television series The Six Million Dollar Man featured one of the most famous fictional cyborgs. Cyborgs in fiction often play up a human contempt for over-dependence on technology, particularly when used for war, and when used in ways that seem to threaten free will. Cyborgs are also often portrayed with physical or mental abilities far exceeding a human counterpart (military forms may have inbuilt weapons, among other things).\n\nReal (as opposed to fictional) cyborgs are more frequently people who use cybernetic technology to repair or overcome the physical and mental constraints of their bodies. While cyborgs are commonly thought of as mammals, they can be any kind of organism.\n\n[Source: wiki]","totalMediaCount":146,"slug":"cyborg","nsfw":false,"childCount":0},"relationships":{"parent":{"links":{"self":"https://kitsu.io/api/edge/categories/26/relationships/parent","related":"https://kitsu.io/api/edge/categories/26/parent"}},"anime":{"links":{"self":"https://kitsu.io/api/edge/categories/26/relationships/anime","related":"https://kitsu.io/api/edge/categories/26/anime"}},"drama":{"links":{"self":"https://kitsu.io/api/edge/categories/26/relationships/drama","related":"https://kitsu.io/api/edge/categories/26/drama"}},"manga":{"links":{"self":"https://kitsu.io/api/edge/categories/26/relationships/manga","related":"https://kitsu.io/api/edge/categories/26/manga"}}}},{"id":"108","type":"categories","links":{"self":"https://kitsu.io/api/edge/categories/108"},"attributes":{"createdAt":"2017-05-31T06:39:04.202Z","updatedAt":"2021-10-02T01:30:58.265Z","title":"Violence","description":"Physical force against self or other, compelling action against one's will on pain of being hurt.","totalMediaCount":1400,"slug":"violence","nsfw":false,"childCount":0},"relationships":{"parent":{"links":{"self":"https://kitsu.io/api/edge/categories/108/relationships/parent","related":"https://kitsu.io/api/edge/categories/108/parent"}},"anime":{"links":{"self":"https://kitsu.io/api/edge/categories/108/relationships/anime","related":"https://kitsu.io/api/edge/categories/108/anime"}},"drama":{"links":{"self":"https://kitsu.io/api/edge/categories/108/relationships/drama","related":"https://kitsu.io/api/edge/categories/108/drama"}},"manga":{"links":{"self":"https://kitsu.io/api/edge/categories/108/relationships/manga","related":"https://kitsu.io/api/edge/categories/108/manga"}}}},{"id":"184","type":"categories","links":{"sel