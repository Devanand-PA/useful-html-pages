/edge/categories/245/manga"}}}},{"id":"246","type":"categories","links":{"self":"https://kitsu.io/api/edge/categories/246"},"attributes":{"createdAt":"2018-12-28T19:19:12.049Z","updatedAt":"2021-10-02T01:31:01.031Z","title":"Isekai","description":"An isekai story is one in which the lead characters are transferred to and become stuck or trapped in another world, one completely different from the one they lived in up until the transfer. The new world is commonly a fictional world.  In order to adapt to their new environment, they must use the abilities and knowledge brought from their former world as well as any that may have been bestowed upon them by their brave new world. In some cases, they will seek and eventually find a way to return; in others, they will gleefully embrace their new life.","totalMediaCount":2812,"slug":"isekai","nsfw":false,"childCount":0},"relationships":{"parent":{"links":{"self":"https://kitsu.io/api/edge/categories/246/relationships/parent","related":"https://kitsu.io/api/edge/categories/246/parent"}},"anime":{"links":{"self":"https://kitsu.io/api/edge/categories/246/relationships/anime","related":"https://kitsu.io/api/edge/categories/246/anime"}},"drama":{"links":{"self":"https://kitsu.io/api/edge/categories/246/relationships/drama","related":"https://kitsu.io/api/edge/categories/246/drama"}},"manga":{"links":{"self":"https://kitsu.io/api/edge/categories/246/relationships/manga","related":"https://kitsu.io/api/edge/categories/246/manga"}}}}],"meta":{"count":218},"links":{"first":"https://kitsu.io/api/edge/categories?page%5Blimit%5D=100&page%5Boffset%5D=0","prev":"https://kitsu.io/api/edge/categories?page%5Blimit%5D=100&page%5Boffset%5D=100","last":"https://kitsu.io/api/edge/categories?page%5Blimit%5D=100&page%5Boffset%5D=118"}}